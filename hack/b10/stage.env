# B-10 fabric parameters for stage. Source this before running the pass.
#
# The bastion (kube-dc-bastion, 88.99.218.47 = Server Auction #2670392) is a
# member of Hetzner vSwitch #65858 alongside the cluster nodes, so it can act as
# a REAL peer on VLAN 4014 that is not part of Kubernetes. That is what makes
# the external-peer assertion meaningful: pod-to-pod only proves the overlay
# works, not that we are on the customer's physical broadcast domain.
#
# Set up on the bastion with:
#   sudo ip link add link enp0s31f6 name enp0s31f6.4014 type vlan id 4014
#   sudo ip link set enp0s31f6.4014 mtu 1400
#   sudo ip addr add 192.168.214.1/24 dev enp0s31f6.4014
#   sudo ip link set enp0s31f6.4014 up
#
# NOTE: that is runtime-only and a bastion reboot loses it. Left deliberately
# non-persistent — it is a test fixture, not infrastructure. It is also a live
# instance of the §18.4 risk: physical truth drifting from what Kubernetes
# believes, with nothing in the platform able to detect it.

# FORCED, not defaulted. `${KUBECONFIG:-...}` only substitutes when the variable
# is UNSET — and a bastion typically exports KUBECONFIG=~/.kube/config, pointing
# at whatever cluster was last used. The soft form silently kept that, and
# 00-preflight.sh read the wrong cluster; had it passed, run-all.sh would have
# created segments, bindings and the whole breach matrix on the WRONG cluster.
export KUBECONFIG=$HOME/.kube/stage_config
export B10_EXPECT_CONTEXT=stage-admin

export B10_ORG=b10
export B10_PROJECT=wire
export B10_BINDING=dc-vlan

# The fabric. ext-cloud reports ALL THREE nodes ready, but only master-1 and
# worker-1 are actually on the vSwitch — hence the nodeSelector is mandatory,
# not optional. worker-2 is the negative placement case.
export B10_PROVIDER_NETWORK=ext-cloud
export B10_VLAN_ID=4014
export B10_MTU=1400                       # Hetzner vSwitch caps at 1400
export B10_NODE_SELECTOR='{"network.kube-dc.com/customer-vlan-4014":"true"}'
export B10_UNPREPARED_NODE=kube-dc-worker-2

# Addressing. 192.168.214.0/24 was chosen after checking every route on the
# bastion and every kube-ovn Subnet on the cluster: 10/8 and 172.16/12 are both
# broadly routed here, and 192.168.{1,100,122,238} are taken. This range appears
# nowhere. There is no DHCP on this vSwitch and the four member servers are all
# ours, so §18.4's "one allocator per range" holds by construction — which is
# NOT the case for a real customer VLAN, where it must be agreed explicitly.
export B10_CIDR=192.168.214.0/24
export B10_GATEWAY=192.168.214.1          # the bastion
export B10_EXTERNAL_PEER=192.168.214.1    # the same machine: a real non-K8s peer
export B10_EXCLUDE_IPS='["192.168.214.1"]'  # keep IPAM off the bastion's address

export B10_ADDRESS_AUTHORITY_CONFIRMED=yes  # true here; NOT transferable to a customer wire

# Tenant identity for the tenant-facing endpoint. Its authorization is a
# SelfSubjectAccessReview under the CALLER's token, so an admin token proves
# nothing — this has to be a real project member. Created for this run with:
#   POST /api/admin/users/b10           (then reset-password temporary=false)
#   OrganizationGroup b10/wire-users -> project wire, role "admin"
# NOTE: the role must be one that EXISTS in the project namespace (admin,
# developer, project-manager, user). Naming a non-existent role creates a
# dangling RoleBinding and every SAR fails with "role not found".
export B10_TENANT_USER=b10user@example.com
export B10_TENANT_PASSWORD='B10testpass!'
