# kube-dc bootstrap init input: kube-dc bootstrap init --config FILE --dry-run
# Parsed as data; never source it in a shell. No tokens, passwords, private
# keys or unseal shares belong here: secrets are file paths or env variables.
# Example: three control-plane nodes (+ workers), a private MetalLB L2 VIP on
# the node network, a supplied wildcard certificate from a private CA, Ceph on
# one raw disk per node, managed services on. Addresses are documentation
# examples; replace every CHANGEME and confirm every address with the site.
KUBE_DC_INIT_SPEC_VERSION=1

# --- Identity and fleet repository ---
CLUSTER_NAME=CHANGEME_NAME
DOMAIN=CHANGEME.example.com
EMAIL=CHANGEME_OPERATOR_EMAIL
KUBE_DC_INIT_MODE=install
KUBE_DC_INIT_PRESET=cloud-vlan
KUBE_DC_INIT_INSTALLATION_KIND=kube-dc
KUBE_DC_INIT_FLEET_MODE=existing-repo
KUBE_DC_INIT_PROVIDER=github
KUBE_DC_INIT_GITHUB_OWNER=CHANGEME_OWNER
KUBE_DC_INIT_GITHUB_REPO=CHANGEME_REPO
# The release's starter as an immutable reference (digest or version tag).
KUBE_DC_INIT_STARTER_REF=oci://ghcr.io/kube-dc/fleet-starter:CHANGEME_BUNDLE_VERSION

# --- Hosts: SSH targets and pinned host keys ---
KUBE_DC_INIT_SSH_HOST=admin@198.51.100.11
KUBE_DC_INIT_SSH_HOST_KEY_SHA256=SHA256:CHANGEME
KUBE_DC_INIT_PRIMARY_NODE=node-1
# Every other node, so init can check each selected OSD disk.
KUBE_DC_INIT_NODE_SSH_HOSTS=node-2=admin@198.51.100.12,node-3=admin@198.51.100.13
KUBE_DC_INIT_NODE_SSH_HOST_KEYS=node-2=SHA256:CHANGEME,node-3=SHA256:CHANGEME

# --- Roles ---
KUBE_OVN_MASTER_NODES=10.20.0.11,10.20.0.12,10.20.0.13
KUBE_OVN_GW_NODES=node-1,node-2,node-3
NODE_CIDR=10.20.0.0/24
MANAGEMENT_API_MODE=service

# --- Internal ranges (no overlap with any site network; pass the same
# POD_CIDR, SVC_CIDR and CLUSTER_DNS to bootstrap install) ---
POD_CIDR=10.100.0.0/16
SVC_CIDR=10.101.0.0/16
CLUSTER_DNS=10.101.0.11
JOIN_CIDR=172.30.0.0/22
INFRA_ATTACHMENT_ENABLED=true
INFRA_ATTACHMENT_ROUTES=10.20.0.0/24,172.30.0.0/22,10.100.0.0/16

# --- External (cloud) network for Projects ---
EXT_NET_INTERFACE=bond0
EXT_NET_VLAN_ID=110
EXT_NET_CIDR=10.30.0.0/24
EXT_NET_GATEWAY=10.30.0.1
EXT_NET_MTU=1500
# Never handed to tenants: the gateway and site infrastructure from the start,
# up to and including the management SNAT address.
EXT_NET_EXCLUDE_IPS=10.30.0.1..10.30.0.20
EXT_NET_MGMT_SNAT_IP=10.30.0.20
EXT_NET_EXTRA_EXCLUDE_IPS=10.30.0.240..10.30.0.254
KUBE_DC_INIT_NODE_EGRESS_ENABLED=false

# --- Front door ---
# The client-facing address, even on a private network.
NODE_EXTERNAL_IP=10.20.0.30
INGRESS_ADDRESS_LAYER=metallb-l2
METALLB_FLOATING_IP=10.20.0.30
METALLB_INTERFACE=CHANGEME_NODE_NETWORK_INTERFACE
# Empty = the gateway nodes (recommended).
KUBE_DC_INIT_INGRESS_NODES=
# This VIP is on the node network (inside INFRA_ATTACHMENT_ROUTES): init also
# derives a Project front door from the addresses right after
# EXT_NET_EXCLUDE_IPS: the internal VIP (here 10.30.0.21) and one anchor per
# gateway node (10.30.0.22-24). Reserve them too.

# --- Certificates ---
TLS_MODE=byo-wildcard
KUBE_DC_INIT_TLS_CERT=/CHANGEME_PRIVATE_DIR/fullchain.pem
KUBE_DC_INIT_TLS_KEY=/CHANGEME_PRIVATE_DIR/privkey.pem
KUBE_DC_INIT_TRUSTED_CA_BUNDLE=/CHANGEME_PRIVATE_DIR/ca.pem

# --- Storage ---
OBJECT_STORAGE_MODE=rook-ceph-multi-node
CEPH_REPLICATION_SIZE=3
CEPH_MON_NODES=node-1,node-2,node-3
CEPH_NODE_1=node-1
CEPH_NODE_1_DEVICE=/dev/disk/by-id/CHANGEME
CEPH_NODE_2=node-2
CEPH_NODE_2_DEVICE=/dev/disk/by-id/CHANGEME
CEPH_NODE_3=node-3
CEPH_NODE_3_DEVICE=/dev/disk/by-id/CHANGEME
S3_HOSTNAME=s3.CHANGEME.example.com
KUBE_DC_INIT_VM_STORAGE_MODE=shared-rbd
KUBE_DC_INIT_VM_GOLDEN=debian-12
MONITORING_STORAGE_CLASS=ceph-block
PROM_STORAGE_CLASS=ceph-block
LOKI_STORAGE_CLASS=ceph-block
OPENBAO_ENABLED=true
OPENBAO_REPLICAS=3

# --- Managed services ---
KUBE_DC_INIT_MANAGED_SERVICES=on
KUBE_DC_INIT_SERVICES_STORAGE_BUDGET=300Gi
KUBE_DC_INIT_PAYG=false
BILLING_PROVIDER=none
