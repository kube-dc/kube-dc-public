# Synthetic site. No private customer addresses or hardware identities.
KUBE_DC_INIT_SPEC_VERSION=1
CLUSTER_NAME=lab-ten
DOMAIN=customer.example.test
NODE_EXTERNAL_IP=192.0.2.11
EMAIL=ops@example.test
KUBE_DC_INIT_MODE=install
KUBE_DC_INIT_FLEET_MODE=existing-repo
KUBE_DC_INIT_REPO=/tmp/example-fleet
KUBE_DC_INIT_PROVIDER=gitlab
KUBE_DC_INIT_PROVIDER_HOST=gitlab.example.test
KUBE_DC_INIT_GITHUB_OWNER=platform
KUBE_DC_INIT_GITHUB_REPO=fleet
KUBE_DC_INIT_INSTALLATION_KIND=kube-dc
KUBE_DC_INIT_MANAGED_SERVICES=on
KUBE_DC_INIT_SERVICES_STORAGE_BUDGET=300Gi
KUBE_DC_INIT_PRESET=cloud-vlan
EXT_NET_INTERFACE=bond0
EXT_NET_VLAN_ID=110
EXT_NET_MTU=1500
NODE_CIDR=192.0.2.0/24
KUBE_OVN_MASTER_NODES=192.0.2.11,192.0.2.12,192.0.2.13
KUBE_OVN_GW_NODES=server-01,server-02,server-03
KUBE_OVN_GW_TYPE=centralized
INGRESS_ADDRESS_LAYER=metallb-l2
METALLB_MODE=l2
METALLB_FLOATING_IP=192.0.2.100
METALLB_INTERFACE=node-network
KUBE_DC_INIT_INGRESS_NODES=server-01,server-02,server-03
KUBE_DC_INIT_NODE_EGRESS_ENABLED=false
KUBE_DC_INIT_PRIMARY_NODE=server-01
KUBE_DC_INIT_SSH_HOST=admin@198.51.100.11
KUBE_DC_INIT_NODE_SSH_HOSTS=server-01=admin@198.51.100.11,server-02=admin@198.51.100.12,server-03=admin@198.51.100.13,server-04=admin@198.51.100.14,server-05=admin@198.51.100.15,server-06=admin@198.51.100.16,server-07=admin@198.51.100.17,server-08=admin@198.51.100.18,server-09=admin@198.51.100.19,server-10=admin@198.51.100.20
OBJECT_STORAGE_MODE=rook-ceph-multi-node
CEPH_REPLICATION_SIZE=3
CEPH_MON_NODES=server-01,server-02,server-03
KUBE_DC_INIT_VM_STORAGE_MODE=shared-rbd
TLS_MODE=byo-wildcard
KUBE_DC_INIT_TLS_CERT=/example/certs/wildcard.crt
KUBE_DC_INIT_TLS_KEY=/example/certs/wildcard.key
KUBE_DC_INIT_TRUSTED_CA_BUNDLE=/example/certs/root.crt
KUBE_DC_INIT_STARTER_REF=oci://registry.example.test/fleet-starter@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
KUBE_DC_INIT_SITE_COMPONENTS=platform=components/private-endpoints
PLATFORM_API_INTERNAL_URL=https://backend.customer.example.test
CEPH_NODE_1=server-01
CEPH_NODE_1_DEVICE=disk/by-id/nvme-Example_NVMe_001
CEPH_NODE_2=server-02
CEPH_NODE_2_DEVICE=disk/by-id/nvme-Example_NVMe_002
CEPH_NODE_3=server-03
CEPH_NODE_3_DEVICE=disk/by-id/nvme-Example_NVMe_003
CEPH_NODE_4=server-04
CEPH_NODE_4_DEVICE=disk/by-id/nvme-Example_NVMe_004
CEPH_NODE_5=server-05
CEPH_NODE_5_DEVICE=disk/by-id/nvme-Example_NVMe_005
CEPH_NODE_6=server-06
CEPH_NODE_6_DEVICE=disk/by-id/nvme-Example_NVMe_006
CEPH_NODE_7=server-07
CEPH_NODE_7_DEVICE=disk/by-id/nvme-Example_NVMe_007
CEPH_NODE_8=server-08
CEPH_NODE_8_DEVICE=disk/by-id/nvme-Example_NVMe_008
CEPH_NODE_9=server-09
CEPH_NODE_9_DEVICE=disk/by-id/nvme-Example_NVMe_009
CEPH_NODE_10=server-10
CEPH_NODE_10_DEVICE=disk/by-id/nvme-Example_NVMe_010
