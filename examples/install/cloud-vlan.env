# kube-dc bootstrap init spec — cloud-vlan preset (shared-NAT tenant networking)
#
#   kube-dc bootstrap init --config cloud-vlan.env
#
# See internal-only.env for the format + precedence notes.

# --- identity ---
CLUSTER_NAME=dc1
DOMAIN=kdc.example.com
NODE_EXTERNAL_IP=203.0.113.10
EMAIL=ops@example.com

# --- network (cloud NAT pool on a provider VLAN) ---
EXT_NET_VLAN_ID=100
EXT_NET_INTERFACE=bond0
KUBE_OVN_MASTER_NODES=10.0.0.5
# Dedicated ingress VIP on the ext-cloud L2 segment.
# Front door: WHO owns the address your users dial. Declaring a
# METALLB_FLOATING_IP below is not enough on its own — a reserved address
# is not assumed to be the front door (spare and undeliverable
# reservations exist), so say which you want:
#   metallb-l2  a floating VIP announced by ARP on a shared L2 segment
#   metallb-bgp the same VIP announced as a /32 to a routed fabric
#   none        no VIP; serve on the ingress nodes' own addresses and
#               install no MetalLB (then remove METALLB_FLOATING_IP)
INGRESS_ADDRESS_LAYER=metallb-l2
METALLB_FLOATING_IP=100.65.0.20
METALLB_INTERFACE=br-ext-cloud

# --- object storage ---
OBJECT_STORAGE_MODE=rook-ceph-local
CEPH_LOCAL_OSD_NODE=dc1-master-1
CEPH_LOCAL_OSD_SIZE_GB=500

# --- install-only orchestration ---
KUBE_DC_INIT_MODE=install
KUBE_DC_INIT_FLEET_MODE=new-repo
KUBE_DC_INIT_PRESET=cloud-vlan
KUBE_DC_INIT_GITHUB_OWNER=my-org
KUBE_DC_INIT_GITHUB_REPO=my-fleet
KUBE_DC_INIT_SSH_HOST=ubuntu@203.0.113.10
