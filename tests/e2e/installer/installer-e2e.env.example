# Greenfield installer E2E — example config. Copy this OUTSIDE the repo,
# fill in your real values, and `source` it before running run-install-e2e.sh:
#
#   cp tests/e2e/installer/installer-e2e.env.example ~/my-installer-e2e.env
#   $EDITOR ~/my-installer-e2e.env
#   source ~/my-installer-e2e.env && tests/e2e/installer/run-install-e2e.sh
#
# All values below are RFC 5737 / example.com placeholders — the repo's
# no-real-infra lint (cli/internal/lint) forbids real IPs/hosts/emails in this
# tree, so NEVER commit a filled-in copy here. Keep it out of the repo.

# RKE2 node name to install (matches the name used in bootstrap init).
export E2E_NODE=master-1

# SSH target for the node — its PUBLIC IP (FIP/EIP), user with passwordless sudo.
export E2E_SSH_HOST=ubuntu@203.0.113.10

# Cluster wildcard domain. *.$E2E_DOMAIN must resolve to the node's public IP.
export E2E_DOMAIN=kdc.example.com

# Where the fetched admin kubeconfig is written (outside any git tree).
export E2E_KUBECONFIG=$HOME/.kube/installer-e2e.kubeconfig

# The `bootstrap init --config` spec (a cluster-config.env-format file with
# KUBE_DC_INIT_* orchestration keys). See docs/platform/installation-guide.md
# §3.3.2 + examples/install/internal-only.env. Keep it out of the repo too.
export E2E_INIT_CONFIG=$HOME/my-installer-e2e-init.env

# --- optional ---
# export E2E_PRESET=internal-only          # default
# export E2E_CLI=./cli/kube-dc             # default: kube-dc on PATH
# export E2E_SSH_KEY=$HOME/.ssh/installer_e2e   # add to a scratch ssh-agent; else uses the running agent
# export E2E_PLATFORM_TIMEOUT=1500         # seconds to wait for platform Kustomization Ready
